generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SAAS MULTI-TENANCY
// ============================================================

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logo             String?
  address          String?
  city             String?
  country          String   @default("SA")
  phone            String?
  email            String?
  taxNumber        String?
  fiscalYearStart  Int      @default(1) // Month: 1=Jan
  baseCurrency     String   @default("SAR")
  plan             Plan     @default(FREE)
  planExpiresAt    DateTime?
  stripeCustomerId String?
  stripeSubId      String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            UserOrganization[]
  accounts         Account[]
  accountGroups    AccountGroup[]
  contacts         Contact[]
  products         Product[]
  warehouses       Warehouse[]
  currencies       OrganizationCurrency[]
  taxRates         TaxRate[]
  costCenters      CostCenter[]
  journals         Journal[]
  invoices         Invoice[]
  bills            Bill[]
  payments         Payment[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  fixedAssets      FixedAsset[]
  budgets          Budget[]
  aiConversations  AIConversation[]
  payrollRuns      PayrollRun[]
  employees        Employee[]
  purchaseOrders   PurchaseOrder[]
  salesOrders      SalesOrder[]
  fiscalYears      FiscalYear[]
  sequences        DocumentSequence[]
  whatsappIntegration WhatsAppIntegration?
  pendingTransactions PendingTransaction[]
  attachments      Attachment[]
  auditLogs        AuditLog[]
  recurringInvoices RecurringInvoice[]
}

enum Plan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?

  organizations UserOrganization[]
  accounts      Account[]  @relation("CreatedBy")
  sessions      Session[]
  aiConversations AIConversation[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(VIEWER)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum OrgRole {
  OWNER
  ADMIN
  ACCOUNTANT
  MANAGER
  VIEWER
}

// ============================================================
// FISCAL YEAR
// ============================================================

model FiscalYear {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean      @default(false)
  closedAt       DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journals       Journal[]
}

// ============================================================
// CHART OF ACCOUNTS (Tally-style: Groups + Ledgers)
// ============================================================

model AccountGroup {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  code           String?
  parentId       String?
  nature         AccountNature
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         AccountGroup? @relation("SubGroups", fields: [parentId], references: [id])
  children       AccountGroup[] @relation("SubGroups")
  accounts       Account[]

  @@unique([organizationId, name])
}

model Account {
  id             String        @id @default(cuid())
  organizationId String
  groupId        String
  code           String
  name           String
  description    String?
  nature         AccountNature
  accountType    AccountType
  currency       String        @default("SAR")
  isActive       Boolean       @default(true)
  isSystem       Boolean       @default(false)
  openingBalance Decimal       @default(0) @db.Decimal(18, 4)
  openingDate    DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group          AccountGroup  @relation(fields: [groupId], references: [id])
  createdBy      User?         @relation("CreatedBy", fields: [createdById], references: [id])
  journalLines   JournalLine[]
  bankAccounts   BankAccount[]
  invoices       Invoice[]     @relation("ARAccount")
  bills          Bill[]        @relation("APAccount")

  @@unique([organizationId, code])
}

enum AccountNature {
  DEBIT  // Assets, Expenses
  CREDIT // Liabilities, Equity, Revenue
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  BANK
  CASH
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  STOCK
  FIXED_ASSET
  TAX
}

// ============================================================
// CURRENCIES
// ============================================================

model OrganizationCurrency {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  symbol         String
  exchangeRate   Decimal      @default(1) @db.Decimal(18, 6)
  isBase         Boolean      @default(false)
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, code])
}

// ============================================================
// TAX RATES
// ============================================================

model TaxRate {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  rate           Decimal      @db.Decimal(8, 4)
  taxType        TaxType      @default(VAT)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  billItems      BillItem[]
  recurringItems RecurringItem[]
}

enum TaxType {
  VAT
  GST
  SALES_TAX
  WITHHOLDING
  EXEMPT
}

// ============================================================
// COST CENTERS
// ============================================================

model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  parentId       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         CostCenter?  @relation("SubCenters", fields: [parentId], references: [id])
  children       CostCenter[] @relation("SubCenters")
  journalLines   JournalLine[]
}

// ============================================================
// CONTACTS (Customers & Vendors)
// ============================================================

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  type           ContactType   @default(BOTH)
  name           String
  displayName    String?
  email          String?
  phone          String?
  mobile         String?
  address        String?
  city           String?
  country        String?
  taxNumber      String?
  creditLimit    Decimal?      @db.Decimal(18, 4)
  paymentTerms   Int           @default(30)
  currency       String        @default("SAR")
  isActive       Boolean       @default(true)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  bills          Bill[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  salesOrders    SalesOrder[]
  recurringInvoices RecurringInvoice[]
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

// ============================================================
// PRODUCTS / INVENTORY
// ============================================================

model Product {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  unit           String         @default("PCS")
  category       String?
  salePrice      Decimal        @default(0) @db.Decimal(18, 4)
  purchasePrice  Decimal        @default(0) @db.Decimal(18, 4)
  reorderLevel   Decimal        @default(0) @db.Decimal(18, 4)
  isInventoried  Boolean        @default(true)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceItems   InvoiceItem[]
  billItems      BillItem[]
  stockLedger    StockLedger[]
  poItems        PurchaseOrderItem[]
  soItems        SalesOrderItem[]

  @@unique([organizationId, code])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  address        String?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockLedger    StockLedger[]
}

model StockLedger {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  date        DateTime
  reference   String
  quantity    Decimal   @db.Decimal(18, 4)
  unitCost    Decimal   @db.Decimal(18, 4)
  type        StockType
  invoiceId   String?
  billId      String?
  createdAt   DateTime  @default(now())

  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

enum StockType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

// ============================================================
// DOCUMENT SEQUENCES
// ============================================================

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  docType        String
  prefix         String
  currentNumber  Int          @default(0)
  padding        Int          @default(4)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, docType])
}

// ============================================================
// JOURNALS (General Ledger - Double Entry Bookkeeping)
// ============================================================

model Journal {
  id             String         @id @default(cuid())
  organizationId String
  fiscalYearId   String?
  number         String
  date           DateTime
  type           JournalType    @default(GENERAL)
  description    String
  reference      String?
  currency       String         @default("SAR")
  exchangeRate   Decimal        @default(1) @db.Decimal(18, 6)
  totalDebit     Decimal        @default(0) @db.Decimal(18, 4)
  totalCredit    Decimal        @default(0) @db.Decimal(18, 4)
  status         JournalStatus  @default(POSTED)
  isReconciled   Boolean        @default(false)
  sourceType     String?        // invoice, bill, payment, etc.
  sourceId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear     FiscalYear?    @relation(fields: [fiscalYearId], references: [id])
  lines          JournalLine[]

  @@unique([organizationId, number])
}

model JournalLine {
  id           String      @id @default(cuid())
  journalId    String
  accountId    String
  costCenterId String?
  description  String?
  debit        Decimal     @default(0) @db.Decimal(18, 4)
  credit       Decimal     @default(0) @db.Decimal(18, 4)
  currency     String      @default("SAR")
  exchangeRate Decimal     @default(1) @db.Decimal(18, 6)
  createdAt    DateTime    @default(now())

  journal      Journal     @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account      Account     @relation(fields: [accountId], references: [id])
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])
}

enum JournalType {
  GENERAL
  PAYMENT
  RECEIPT
  SALES
  PURCHASE
  CONTRA
  CREDIT_NOTE
  DEBIT_NOTE
  OPENING
  CLOSING
  PAYROLL
  DEPRECIATION
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

// ============================================================
// INVOICES (Sales)
// ============================================================

enum InvoiceType {
  INVOICE
  CREDIT_NOTE
}

model Invoice {
  id                  String        @id @default(cuid())
  organizationId      String
  contactId           String
  arAccountId         String?
  number              String
  type                InvoiceType   @default(INVOICE)
  creditedInvoiceId   String?
  reason              String?
  date                DateTime
  dueDate             DateTime
  currency            String        @default("SAR")
  exchangeRate        Decimal       @default(1) @db.Decimal(18, 6)
  subtotal            Decimal       @default(0) @db.Decimal(18, 4)
  discountAmount      Decimal       @default(0) @db.Decimal(18, 4)
  taxAmount           Decimal       @default(0) @db.Decimal(18, 4)
  total               Decimal       @default(0) @db.Decimal(18, 4)
  amountPaid          Decimal       @default(0) @db.Decimal(18, 4)
  amountDue           Decimal       @default(0) @db.Decimal(18, 4)
  status              InvoiceStatus @default(DRAFT)
  notes               String?
  terms               String?
  journalId           String?
  salesOrderId        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact             Contact       @relation(fields: [contactId], references: [id])
  arAccount           Account?      @relation("ARAccount", fields: [arAccountId], references: [id])
  creditedInvoice     Invoice?      @relation("CreditNotes", fields: [creditedInvoiceId], references: [id])
  creditNotes         Invoice[]     @relation("CreditNotes")
  items               InvoiceItem[]
  payments            Payment[]

  @@unique([organizationId, number])
}

model InvoiceItem {
  id          String    @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal   @db.Decimal(18, 4)
  unitPrice   Decimal   @db.Decimal(18, 4)
  discount    Decimal   @default(0) @db.Decimal(8, 4)
  taxRateId   String?
  taxAmount   Decimal   @default(0) @db.Decimal(18, 4)
  total       Decimal   @db.Decimal(18, 4)
  accountId   String?
  sortOrder   Int       @default(0)

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  CREDIT_NOTE
}

// ============================================================
// BILLS (Purchases)
// ============================================================

enum BillType {
  BILL
  DEBIT_NOTE
}

model Bill {
  id               String      @id @default(cuid())
  organizationId   String
  contactId        String
  apAccountId      String?
  number           String
  type             BillType    @default(BILL)
  creditedBillId   String?
  reason           String?
  vendorRef        String?
  date             DateTime
  dueDate          DateTime
  currency         String      @default("SAR")
  exchangeRate     Decimal     @default(1) @db.Decimal(18, 6)
  subtotal         Decimal     @default(0) @db.Decimal(18, 4)
  discountAmount   Decimal     @default(0) @db.Decimal(18, 4)
  taxAmount        Decimal     @default(0) @db.Decimal(18, 4)
  total            Decimal     @default(0) @db.Decimal(18, 4)
  amountPaid       Decimal     @default(0) @db.Decimal(18, 4)
  amountDue        Decimal     @default(0) @db.Decimal(18, 4)
  status           BillStatus  @default(DRAFT)
  notes            String?
  journalId        String?
  purchaseOrderId  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact          Contact      @relation(fields: [contactId], references: [id])
  apAccount        Account?     @relation("APAccount", fields: [apAccountId], references: [id])
  creditedBill     Bill?        @relation("DebitNotes", fields: [creditedBillId], references: [id])
  debitNotes       Bill[]       @relation("DebitNotes")
  items            BillItem[]
  payments         Payment[]

  @@unique([organizationId, number])
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  productId   String?
  description String
  quantity    Decimal  @db.Decimal(18, 4)
  unitPrice   Decimal  @db.Decimal(18, 4)
  discount    Decimal  @default(0) @db.Decimal(8, 4)
  taxRateId   String?
  taxAmount   Decimal  @default(0) @db.Decimal(18, 4)
  total       Decimal  @db.Decimal(18, 4)
  accountId   String?
  sortOrder   Int      @default(0)

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  taxRate     TaxRate? @relation(fields: [taxRateId], references: [id])
}

enum BillStatus {
  DRAFT
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id             String         @id @default(cuid())
  organizationId String
  contactId      String?
  invoiceId      String?
  billId         String?
  type           PaymentType
  date           DateTime
  amount         Decimal        @db.Decimal(18, 4)
  currency       String         @default("SAR")
  exchangeRate   Decimal        @default(1) @db.Decimal(18, 6)
  method         PaymentMethod  @default(BANK_TRANSFER)
  reference      String?
  bankAccountId  String?
  journalId      String?
  notes          String?
  createdAt      DateTime       @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?       @relation(fields: [contactId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  bill           Bill?          @relation(fields: [billId], references: [id])
  bankAccount    BankAccount?   @relation(fields: [bankAccountId], references: [id])
}

enum PaymentType {
  INCOMING
  OUTGOING
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  ONLINE
}

// ============================================================
// BANK ACCOUNTS & RECONCILIATION
// ============================================================

model BankAccount {
  id             String           @id @default(cuid())
  organizationId String
  accountId      String
  name           String
  bankName       String?
  accountNumber  String?
  iban           String?
  currency       String           @default("SAR")
  currentBalance Decimal          @default(0) @db.Decimal(18, 4)
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account          @relation(fields: [accountId], references: [id])
  transactions   BankTransaction[]
  payments       Payment[]
}

model BankTransaction {
  id             String                @id @default(cuid())
  organizationId String
  bankAccountId  String
  date           DateTime
  description    String
  reference      String?
  debit          Decimal               @default(0) @db.Decimal(18, 4)
  credit         Decimal               @default(0) @db.Decimal(18, 4)
  balance        Decimal               @db.Decimal(18, 4)
  status         BankTransactionStatus @default(UNRECONCILED)
  journalId      String?
  createdAt      DateTime              @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount           @relation(fields: [bankAccountId], references: [id])
}

enum BankTransactionStatus {
  UNRECONCILED
  RECONCILED
  EXCLUDED
}

// ============================================================
// FIXED ASSETS
// ============================================================

model FixedAsset {
  id                 String          @id @default(cuid())
  organizationId     String
  name               String
  code               String
  category           String
  purchaseDate       DateTime
  purchasePrice      Decimal         @db.Decimal(18, 4)
  depreciationMethod DeprecMethod    @default(STRAIGHT_LINE)
  usefulLife         Int
  salvageValue       Decimal         @default(0) @db.Decimal(18, 4)
  currentValue       Decimal         @db.Decimal(18, 4)
  status             AssetStatus     @default(ACTIVE)
  disposalDate       DateTime?
  disposalAmount     Decimal?        @db.Decimal(18, 4)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  depreciations      AssetDepreciation[]
}

model AssetDepreciation {
  id         String     @id @default(cuid())
  assetId    String
  date       DateTime
  amount     Decimal    @db.Decimal(18, 4)
  bookValue  Decimal    @db.Decimal(18, 4)
  journalId  String?
  createdAt  DateTime   @default(now())

  asset      FixedAsset @relation(fields: [assetId], references: [id])
}

enum DeprecMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  SUM_OF_YEARS
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  UNDER_REPAIR
}

// ============================================================
// PURCHASE ORDERS
// ============================================================

model PurchaseOrder {
  id             String      @id @default(cuid())
  organizationId String
  contactId      String
  number         String
  date           DateTime
  expectedDate   DateTime?
  currency       String      @default("SAR")
  subtotal       Decimal     @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal     @default(0) @db.Decimal(18, 4)
  total          Decimal     @default(0) @db.Decimal(18, 4)
  status         POStatus    @default(DRAFT)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id])
  items          PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id         String        @id @default(cuid())
  poId       String
  productId  String?
  description String
  quantity   Decimal       @db.Decimal(18, 4)
  unitPrice  Decimal       @db.Decimal(18, 4)
  total      Decimal       @db.Decimal(18, 4)
  received   Decimal       @default(0) @db.Decimal(18, 4)

  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product    Product?      @relation(fields: [productId], references: [id])
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIAL
  RECEIVED
  CANCELLED
}

// ============================================================
// SALES ORDERS
// ============================================================

model SalesOrder {
  id             String      @id @default(cuid())
  organizationId String
  contactId      String
  number         String
  date           DateTime
  expectedDate   DateTime?
  currency       String      @default("SAR")
  subtotal       Decimal     @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal     @default(0) @db.Decimal(18, 4)
  total          Decimal     @default(0) @db.Decimal(18, 4)
  status         SOStatus    @default(DRAFT)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id])
  items          SalesOrderItem[]
}

model SalesOrderItem {
  id          String     @id @default(cuid())
  soId        String
  productId   String?
  description String
  quantity    Decimal    @db.Decimal(18, 4)
  unitPrice   Decimal    @db.Decimal(18, 4)
  total       Decimal    @db.Decimal(18, 4)
  delivered   Decimal    @default(0) @db.Decimal(18, 4)

  so          SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id])
}

enum SOStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  DELIVERED
  INVOICED
  CANCELLED
}

// ============================================================
// PAYROLL
// ============================================================

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  name           String
  email          String?
  phone          String?
  department     String?
  position       String?
  basicSalary    Decimal      @db.Decimal(18, 4)
  joinDate       DateTime
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips       Payslip[]
}

model PayrollRun {
  id             String       @id @default(cuid())
  organizationId String
  period         String
  startDate      DateTime
  endDate        DateTime
  payDate        DateTime
  status         PayrollStatus @default(DRAFT)
  totalGross     Decimal      @default(0) @db.Decimal(18, 4)
  totalDeductions Decimal     @default(0) @db.Decimal(18, 4)
  totalNet       Decimal      @default(0) @db.Decimal(18, 4)
  journalId      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payslips       Payslip[]
}

model Payslip {
  id            String     @id @default(cuid())
  payrollRunId  String
  employeeId    String
  basicSalary   Decimal    @db.Decimal(18, 4)
  allowances    Decimal    @default(0) @db.Decimal(18, 4)
  overtime      Decimal    @default(0) @db.Decimal(18, 4)
  grossSalary   Decimal    @db.Decimal(18, 4)
  taxDeduction  Decimal    @default(0) @db.Decimal(18, 4)
  otherDeductions Decimal  @default(0) @db.Decimal(18, 4)
  netSalary     Decimal    @db.Decimal(18, 4)
  status        PayslipStatus @default(PENDING)

  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee      Employee   @relation(fields: [employeeId], references: [id])
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  PAID
}

enum PayslipStatus {
  PENDING
  PAID
}

// ============================================================
// BUDGETS
// ============================================================

model Budget {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  fiscalYear     String
  startDate      DateTime
  endDate        DateTime
  status         BudgetStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          BudgetLine[]
}

model BudgetLine {
  id        String  @id @default(cuid())
  budgetId  String
  accountId String
  period    String
  amount    Decimal @db.Decimal(18, 4)

  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}

enum BudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

// ============================================================
// AI AGENT
// ============================================================

model AIConversation {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  title          String      @default("New Conversation")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  messages       AIMessage[]
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AIRole
  content        String         @db.Text
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum AIRole {
  USER
  ASSISTANT
  TOOL
}

// ============================================================
// WHATSAPP INTEGRATION
// ============================================================

model WhatsAppIntegration {
  id                 String               @id @default(cuid())
  organizationId     String               @unique
  phoneNumberId      String
  accessToken        String
  webhookVerifyToken String               @default("hesabpro")
  groupId            String?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pendingTransactions PendingTransaction[]
}

model PendingTransaction {
  id                  String              @id @default(cuid())
  organizationId      String
  whatsappIntId       String?
  messageId           String?
  senderPhone         String
  senderName          String?
  originalMessage     String              @db.Text
  parsedData          Json
  status              PendingTxStatus     @default(WAITING)
  confirmationSentAt  DateTime?
  confirmedAt         DateTime?
  confirmedBy         String?
  rejectedAt          DateTime?
  rejectionReason     String?
  journalId           String?
  invoiceId           String?
  billId              String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappInt         WhatsAppIntegration? @relation(fields: [whatsappIntId], references: [id])
}

enum PendingTxStatus {
  WAITING
  CONFIRMED
  REJECTED
  POSTED
  FAILED
}

// ============================================================
// ATTACHMENTS
// ============================================================

model Attachment {
  id             String       @id @default(cuid())
  organizationId String
  uploadedBy     String
  name           String
  mimeType       String
  size           Int
  data           Bytes
  entityType     String       // INVOICE | BILL | JOURNAL | EXPENSE | OTHER
  entityId       String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader       User         @relation(fields: [uploadedBy], references: [id])
}

// ============================================================
// AUDIT TRAIL
// ============================================================

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  userName       String
  action         String   // CREATE | UPDATE | DELETE | SEND | POST | CANCEL | PAY
  entityType     String   // INVOICE | BILL | JOURNAL | CONTACT | PRODUCT | PAYMENT | SETTINGS | USER
  entityId       String
  entityLabel    String?  // human-readable label e.g. invoice number
  changes        Json?    // { field: [oldValue, newValue] }
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
}

// ============================================================
// RECURRING INVOICES
// ============================================================

model RecurringInvoice {
  id             String              @id @default(cuid())
  organizationId String
  contactId      String
  title          String
  frequency      RecurringFrequency
  dueDays        Int                 @default(30)
  nextDate       DateTime
  endDate        DateTime?
  status         RecurringStatus     @default(ACTIVE)
  totalGenerated Int                 @default(0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact             @relation(fields: [contactId], references: [id])
  items          RecurringItem[]

  @@index([organizationId, status, nextDate])
}

model RecurringItem {
  id                 String           @id @default(cuid())
  recurringInvoiceId String
  description        String
  quantity           Decimal          @default(1) @db.Decimal(18, 4)
  unitPrice          Decimal          @db.Decimal(18, 4)
  taxRateId          String?
  sortOrder          Int              @default(0)

  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  taxRate            TaxRate?         @relation(fields: [taxRateId], references: [id])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}
